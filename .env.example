# Toy Relay 环境变量示例
# 复制为 .env 然后填值, 或在 shell 里 export

# ===== API 认证 =====
# 固定 API key (不设的话, 首次启动会自动生成一个写到 state/api_key.txt)
# 推荐长度: 32 字符以上, 推荐用: python -c "import secrets; print(secrets.token_urlsafe(24))"
TOY_API_KEY=

# ===== 服务器 =====
# 监听端口 (默认 8765)
TOY_PORT=8765

# ===== 部署时填 =====
# 你的 VPS 公网域名 (Tailscale HTTPS 地址)
# 例: https://your-host.your-tailnet.ts.net
PUBLIC_BASE_URL=